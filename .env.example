# ============================================================
# Proofly Frontend Environment Variables
# ============================================================

# --- Gemini API (injected by AI Studio at runtime) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- App URL ---
APP_URL="MY_APP_URL"

# --- Data mode: "mock" keeps mock data, "live" uses Supabase ---
VITE_DATA_MODE=live

# --- Supabase (get from: https://pbexpyjmsdltjhnmejjk.supabase.co → Settings → API) ---
VITE_SUPABASE_URL=https://pbexpyjmsdltjhnmejjk.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Z3yAq-h1ZR3XgQDjfLEWzg_tReHrPZa

# --- FastAPI AI Service URL ---
VITE_AI_URL=http://localhost:8000
